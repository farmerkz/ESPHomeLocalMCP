# Конфигурация подключения к ESPHome Device Builder API (формат TOML)

# IP-адрес или хост сервера ESPHome (по умолчанию "localhost")
host = "localhost"

# Порт API сервера ESPHome (по умолчанию 6052)
port = 6052

# Использовать защищённое соединение WSS (WebSocket Secure).
# true  — всегда wss:// (для Traefik/HTTPS/reverse proxy)
# false — всегда ws://  (для прямого локального подключения)
# Если параметр не задан — автоопределение: wss:// для портов 443 и 8443, иначе ws://
# ssl = true

# --- Пример для подключения через Traefik / HTTPS ---
# host = "esphome.example.com"
# port = 443
# ssl = true   # можно не указывать — автоматически определится по порту 443
